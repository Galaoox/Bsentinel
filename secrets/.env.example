# Configuración de la aplicación
APP_NAME=bsentinel
APP_VERSION=1.0.0
APP_ENVIRONMENT=local
PORT=8000
LOG_LEVEL=INFO

# Configuración de base de datos
PERSISTENCE_BACKEND=sql
DATABASE_URL=postgresql+asyncpg://bsentinel:bsentinel@localhost:5432/bsentinel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Configuración de scraping
SCRAPING_TIMEOUT=30

# Runtime principal: http | browser (browser requiere Chromium instalado)
SCRAPING_RUNTIME=http

# Runtime HTTP
SCRAPING_HTTP_TIMEOUT=30
SCRAPING_HTTP_RETRIES=2
SCRAPING_HTTP_TRANSIENT_RETRY_ATTEMPTS=2
SCRAPING_HTTP_TRANSIENT_RETRY_DELAY_MS=250
SCRAPING_HTTP_PROFILE=chrome_stable
SCRAPING_HTTP_HTTP3=false
SCRAPING_HTTP_STEALTHY_HEADERS=true

# Opcional: descomentar y reemplazar con el endpoint real del proveedor.
# Solo se aplica a SCRAPING_RUNTIME=http; omitir para conectar sin proxy.
# SCRAPING_HTTP_PROXY=http://usuario:contrasena@host:puerto

# Opcional: omitir para usar la identidad del perfil HTTP.
# SCRAPING_HTTP_IMPERSONATE=chrome

# Runtime de navegador (se selecciona explicitamente; no hay fallback automatico)
SCRAPING_BROWSER_HEADLESS=true
SCRAPING_BROWSER_TIMEOUT_MS=45000
SCRAPING_BROWSER_MAX_PAGES=3
SCRAPING_BROWSER_DISABLE_RESOURCES=true
SCRAPING_BROWSER_NETWORK_IDLE=true
SCRAPING_BROWSER_SOLVE_CLOUDFLARE=false
SCRAPING_BROWSER_REAL_CHROME=false

# Scheduler
# Para probar cada minuto: SCHEDULER_SCRAPE_INTERVAL_HOURS=0.016666666666666666
SCHEDULER_SCRAPE_INTERVAL_HOURS=6

# Configuración de OpenLibrary
OPENLIBRARY_API_URL=https://openlibrary.org

# Autenticacion (valores de ejemplo para desarrollo local)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=changeme
JWT_SECRET_KEY=change-me-in-production-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
